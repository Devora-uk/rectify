# Rybbit analytics (https://rybbit.com)
# Site ID from your Rybbit dashboard
NEXT_PUBLIC_RYBBIT_SITE_ID=bd276ef636d9
# Hosted tracking (default). Change only if self-hosting Rybbit.
NEXT_PUBLIC_RYBBIT_HOST=https://app.rybbit.io

# Resend: used for contact, CV and partnership applications
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Where internal notifications are sent. Atlas can sync this inbox during onboarding.
ENQUIRY_EMAIL=isaac.salakov@rectifyinternational.com

# Optional. Defaults to Rectify <info@rectifyinternational.com>
RESEND_FROM_EMAIL=Rectify <info@rectifyinternational.com>

# Atlas CRMx: leave unset until onboarding is complete.
# Partnership applications currently go through Resend into ENQUIRY_EMAIL.
# Once Atlas is connected to that inbox, those emails can sync automatically.
# Add a direct webhook later if Atlas provides one:
# ATLAS_WEBHOOK_URL=
# ATLAS_API_KEY=

# Insights desk at /studio — for the content specialist
# Shared password to sign in. Keep this private.
INSIGHTS_STUDIO_PASSWORD=choose-a-long-password
# Random string used to sign the login cookie. Any long secret is fine.
INSIGHTS_STUDIO_SECRET=choose-a-long-random-secret

# GitHub backup. Create a fine-grained personal access token with
# Contents: Read and write on Devora-uk/rectify (or your fork).
GITHUB_TOKEN=github_pat_your_token_here
GITHUB_OWNER=Devora-uk
GITHUB_REPO=rectify
GITHUB_BRANCH=main

# Optional. Vercel → Project → Settings → Git → Deploy Hooks.
# Publishing already commits to GitHub; if this project is connected to the
# repo, Vercel rebuilds from that commit. The hook is an extra explicit rebuild.
VERCEL_DEPLOY_HOOK_URL=
